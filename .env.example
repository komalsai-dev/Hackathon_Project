# Environment configuration (Optional - SQLite is the default and needs no config)
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=data/output/course_demand.sqlite

# Optional: PostgreSQL / Supabase connection (if running docker-compose or remote cloud)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=course_demand
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
